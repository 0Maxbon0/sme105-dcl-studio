{
  "name": "sme105-dcl-studio-android",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "native:bundle": "esbuild app/js/native-bridge-entry.js --bundle --format=esm --platform=browser --target=es2022 --outfile=app/vendor/native-bridge.js",
    "test": "node --test app/tests/*.test.mjs",
    "android:sync": "npm run native:bundle && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7"
  }
}
